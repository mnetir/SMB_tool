<header class="pds-header">
    <div class="pds-header-left">
        <button class="pds-sidebar-toggle" aria-label="باز و بسته کردن منو">
            <i class="pds-icon-menu"></i>
        </button>
        <span class="pds-header-title">سامانه مدیریت کسب و کار</span>
    </div>
    <div class="pds-header-center">
        <div class="pds-search-box">
            <i class="pds-icon-search"></i>
            <input type="text" placeholder="جستجو..." class="pds-search-input" />
        </div>
    </div>
    <div class="pds-header-right">
        <button class="pds-header-icon" aria-label="اعلان‌ها">
            <i class="pds-icon-bell"></i>
            <span class="pds-badge pds-badge-danger">3</span>
        </button>
        <button class="pds-header-icon" aria-label="تغییر تم">
            <i class="pds-icon-moon"></i>
        </button>
        <div class="pds-user-menu">
            <div class="pds-avatar pds-avatar-sm">مد</div>
            <span class="pds-user-name">مدیر سیستم</span>
            <i class="pds-icon-chevron-down"></i>
        </div>
    </div>
</header>